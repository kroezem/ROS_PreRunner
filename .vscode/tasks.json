{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Runner: Map",
      "type": "shell",
      "command": "ros2 launch runner_bringup map.launch.py",
      "dependsOn": "Stop all launches",
      "problemMatcher": []
    },
    {
      "label": "Runner: Localize",
      "type": "shell",
      "command": "ros2 launch runner_bringup localize.launch.py map_name:=${input:runnerMap}",
      "dependsOn": "Stop all launches",
      "problemMatcher": []
    },
    {
      "label": "Runner: Teleop",
      "type": "shell",
      "command": "ros2 launch runner_bringup teleop.launch.py",
      "dependsOn": "Stop all launches",
      "problemMatcher": []
    },
    {
      "label": "Runner: Encoder (standalone)",
      "type": "shell",
      "command": "ros2 run runner_encoder encoder_node",
      "problemMatcher": []
    },
    {
      "label": "Stop all launches",
      "type": "shell",
      "command": "pkill -INT -f 'ros2 launch runner_bringup' ; pkill -INT -f motor_node ; sleep 1 ; sudo systemctl restart runner-pwm-setup.service || true",
      "problemMatcher": []
    },
    {
      "label": "Foxglove bridge (ad-hoc)",
      "type": "shell",
      "command": "ros2 launch foxglove_bridge foxglove_bridge_launch.xml",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "runnerMap",
      "type": "pickString",
      "description": "Select the slam_toolbox map",
      "options": [
        "house_good_v1",
        "bedroom_phase_b_503"
      ],
      "default": "house_good_v1"
    }
  ]
}
