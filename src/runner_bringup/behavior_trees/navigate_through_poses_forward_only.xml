<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="StartWithFreshPath">
      <UnsetBlackboard key="path"/>
      <SetBlackboard value="initial_plan" output_key="replan_reason"/>
      <RecoveryNode
        number_of_retries="1"
        name="ReplanAfterControllerPatience">
        <PipelineSequence name="NavigateRouteWithReplanningForwardOnly">
          <RateController hz="3.0">
            <RecoveryNode
              number_of_retries="1"
              name="ClearGlobalCostmapOnPlanningFailure">
              <Fallback name="ReplanRouteWhenCommitmentAllows">
                <ReactiveSequence name="RetainCommittedPath">
                  <PathExists path="{path}"/>
                  <Fallback name="GoalUnchangedOrMarkUpdate">
                    <Inverter>
                      <GlobalUpdatedGoal/>
                    </Inverter>
                    <Sequence>
                      <SetBlackboard value="goal_update" output_key="replan_reason"/>
                      <AlwaysFailure/>
                    </Sequence>
                  </Fallback>
                  <PersistentPathValid
                    path="{path}"
                    corridor_length="1.25"
                    required_observations="3"
                    max_progress_search_distance="2.0"
                    robot_frame="base_link"
                    transform_tolerance="0.3"
                    replan_reason="{replan_reason}"/>
                </ReactiveSequence>
                <Sequence name="GenerateValidateAndCommitCandidate">
                  <RemovePassedGoals
                    input_goals="{goals}"
                    output_goals="{goals}"
                    radius="0.20"/>
                  <Fallback name="SelectCertifiedCandidateForwardFirst">
                    <Sequence name="TryForwardCandidate">
                      <Fallback name="GenerateForwardCandidate">
                        <ComputePathThroughPoses
                          goals="{goals}"
                          path="{candidate_path}"
                          planner_id="ForwardGridBased"
                          error_code_id="{compute_path_error_code}"/>
                        <Sequence>
                          <ReportPathCommitment event="forward_planning_failed" reason="no_forward_candidate"/>
                          <AlwaysFailure/>
                        </Sequence>
                      </Fallback>
                      <Fallback name="CertifyForwardCandidate">
                        <Sequence>
                          <CertifyCandidatePath
                            path="{candidate_path}"
                            physical_curvature_limit="2.1236"
                            curvature_margin="0.95"
                            curvature_window="0.15"
                            minimum_reversal_segment="0.10"
                            minimum_pose_step="0.01"
                            direction_projection_threshold="0.5"
                            certification_reason="{candidate_certification_reason}"/>
                          <ReportPathCommitment event="forward_candidate_accepted" reason="{candidate_certification_reason}"/>
                        </Sequence>
                        <Sequence>
                          <ReportPathCommitment event="candidate_certification_rejected" reason="{candidate_certification_reason}"/>
                          <AlwaysFailure/>
                        </Sequence>
                      </Fallback>
                    </Sequence>
                    <Sequence name="TryReverseFallbackCandidate">
                      <ReportPathCommitment event="reverse_fallback_attempted" reason="forward_no_certified_candidate"/>
                      <Fallback name="GenerateReverseCandidate">
                        <ComputePathThroughPoses
                          goals="{goals}"
                          path="{candidate_path}"
                          planner_id="ReverseGridBased"
                          error_code_id="{compute_path_error_code}"/>
                        <Sequence>
                          <ReportPathCommitment event="reverse_planning_failed" reason="no_reverse_candidate"/>
                          <AlwaysFailure/>
                        </Sequence>
                      </Fallback>
                      <Fallback name="CertifyReverseCandidate">
                        <Sequence>
                          <CertifyCandidatePath
                            path="{candidate_path}"
                            physical_curvature_limit="2.1236"
                            curvature_margin="0.95"
                            curvature_window="0.15"
                            minimum_reversal_segment="0.10"
                            minimum_pose_step="0.01"
                            direction_projection_threshold="0.5"
                            certification_reason="{candidate_certification_reason}"/>
                          <ReportPathCommitment event="reverse_candidate_accepted" reason="{candidate_certification_reason}"/>
                        </Sequence>
                        <Sequence>
                          <ReportPathCommitment event="candidate_certification_rejected" reason="{candidate_certification_reason}"/>
                          <AlwaysFailure/>
                        </Sequence>
                      </Fallback>
                    </Sequence>
                    <Sequence>
                      <ReportPathCommitment event="planning_exhausted" reason="no_certified_candidate"/>
                      <AlwaysFailure/>
                    </Sequence>
                  </Fallback>
                  <Fallback name="ValidateCandidateAgainstCurrentGlobalCostmap">
                    <Sequence>
                      <CandidatePathValid
                        path="{candidate_path}"
                        global_frame="map"
                        robot_frame="base_link"
                        transform_tolerance="0.3"
                        rejection_reason="{candidate_rejection_reason}"/>
                      <SetBlackboard value="{candidate_path}" output_key="path"/>
                      <ReportPathCommitment
                        event="path_committed"
                        reason="{replan_reason}"/>
                    </Sequence>
                    <Sequence>
                      <ReportPathCommitment
                        event="candidate_rejected"
                        reason="{candidate_rejection_reason}"/>
                      <AlwaysFailure/>
                    </Sequence>
                  </Fallback>
                </Sequence>
              </Fallback>
              <ClearEntireCostmap
                name="ClearGlobalCostmap"
                service_name="global_costmap/clear_entirely_global_costmap"/>
            </RecoveryNode>
          </RateController>
          <FollowPath
            path="{path}"
            controller_id="FollowPath"
            goal_checker_id="goal_checker"
            error_code_id="{follow_path_error_code}"/>
        </PipelineSequence>
        <Sequence name="ForceOneReplanAfterLocalControlFailure">
          <WouldAControllerRecoveryHelp
            error_code="{follow_path_error_code}"/>
          <SetBlackboard value="recovery_replan" output_key="replan_reason"/>
          <UnsetBlackboard key="path"/>
        </Sequence>
      </RecoveryNode>
    </Sequence>
  </BehaviorTree>
</root>
