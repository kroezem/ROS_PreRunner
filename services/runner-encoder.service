[Unit]
Description=Runner wheel encoder hardware owner

[Service]
Type=simple
User=matti
Group=matti
WorkingDirectory=/home/matti/runner_ws
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/matti/runner_ws/install/setup.bash && exec ros2 run runner_encoder encoder_node'
Restart=on-failure
RestartSec=0.1

[Install]
WantedBy=multi-user.target
