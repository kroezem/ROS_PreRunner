[Unit]
Description=Runner persistent rosbag2 MCAP recording executor
After=network.target runner-command-authority.service

[Service]
Type=simple
User=matti
Group=matti
WorkingDirectory=/home/matti/runner_ws
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/matti/runner_ws/install/setup.bash && exec ros2 run runner_paddock recording_executor'
Restart=always
RestartSec=2
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=20
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
