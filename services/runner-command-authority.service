[Unit]
Description=Runner offline Paddock command-authority supervisor
After=network.target

[Service]
Type=simple
User=matti
Group=matti
WorkingDirectory=/home/matti/runner_ws
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/matti/runner_ws/install/setup.bash && exec ros2 run runner_paddock command_authority'
Restart=always
RestartSec=2
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=15
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
