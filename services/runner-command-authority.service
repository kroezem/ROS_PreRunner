[Unit]
Description=Runner Paddock command authority (sole supervised /cmd_vel_auto writer)
After=network.target runner-stop-enforcer.service

[Service]
Type=simple
User=matti
Group=matti
WorkingDirectory=/home/matti/runner_ws
# lease_timeout_sec is the browser-disconnect backstop for a held RUN: after
# this long without a fresh ordered control event the lease expires, RUN is
# revoked and autonomy brakes. 0.5 s is a deliberately forgiving first-
# integration value for a Wi-Fi operator tablet; measure the real end-to-end
# budget and tighten it before traction is reconnected. The browser also
# sends RUN_RELEASED proactively on pointer-up / blur / hide, so this only
# governs an actual crash or link loss.
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/matti/runner_ws/install/setup.bash && exec ros2 run runner_paddock command_authority --ros-args -p lease_timeout_sec:=0.5'
Restart=always
RestartSec=2
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=15
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
