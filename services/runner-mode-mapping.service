[Unit]
Description=Runner mutually exclusive MAPPING application graph
Conflicts=runner-mode-autonomy.service
After=runner-motor.service runner-encoder.service

[Service]
Type=simple
User=matti
Group=matti
WorkingDirectory=/home/matti/runner_ws
Environment=PADDOCK_MAP_DIRECTORY=/home/matti/runner_ws/maps
Environment=PADDOCK_AUTONOMY_MAP_FILE=/run/runner-paddock/autonomy-map
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/matti/runner_ws/install/setup.bash && exec ros2 run runner_paddock mode_launcher mapping'
Restart=no
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=20
SendSIGKILL=yes

# Deliberately no [Install]: the supervisor is the sole start/stop owner.
