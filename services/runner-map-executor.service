[Unit]
Description=Runner persistent Paddock map-session executor
After=network.target runner-stop-enforcer.service runner-mode-supervisor.service
Wants=runner-mode-supervisor.service

[Service]
Type=simple
User=matti
Group=matti
WorkingDirectory=/home/matti/runner_ws
Environment=PADDOCK_MAP_DIRECTORY=/home/matti/runner_ws/maps
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/matti/runner_ws/install/setup.bash && exec ros2 run runner_paddock map_executor'
Restart=always
RestartSec=2
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=15
NoNewPrivileges=yes

# The executor never starts/stops units; NEW MAP is a mode request to the
# supervisor. No polkit grant is required.
[Install]
WantedBy=multi-user.target
